# Sao chép file này thành .streamlit/secrets.toml (KHÔNG commit lên GitHub),
# hoặc dán nội dung vào phần Secrets của Streamlit Community Cloud.

BOOTSTRAP_SERVERS = "cell-1.streaming.<region>.oci.oraclecloud.com:9092"
TOPIC = "DemoStreamingFashion"
SASL_USERNAME = "<tenancy>/<username>/<ocid1.streampool...>"
OCI_AUTH_TOKEN = "<auth-token-moi-sau-khi-rotate>"
